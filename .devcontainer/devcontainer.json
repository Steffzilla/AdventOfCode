{
  "name": "Advent of Code",
  "image": "ubuntu:24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "installMaven": true
    }
  },
  "remoteUser": "ubuntu",
  "containerUser": "ubuntu",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=${localEnv:USERPROFILE}/.claude,target=/home/ubuntu/.claude,type=bind",
    "source=${localEnv:USERPROFILE}/.claude.json,target=/home/ubuntu/.claude.json,type=bind"
  ],
  "postCreateCommand": [
     "git",
     "config",
     "--global",
     "--add",
     "safe.directory",
     "*"
  ]
}
